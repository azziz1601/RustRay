<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg"
        android:title="Pengaturan Teknis"
        android:titleTextColor="@color/text"
        app:menu="@menu/edit"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="PRESET CEPAT"
                android:textAppearance="@style/TextAppearance.RustRay.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetGaming"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Preset Game"
                    android:textColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetDefault"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Reset Default"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Preset Game menyetel MTU 1380, profil Throughput, matikan IPv6, Sniffing, dan FakeIP agar ping lebih stabil dan minim jitter."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="TUN &amp; PERFORMA"
                android:textAppearance="@style/TextAppearance.RustRay.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="TUN MTU (1280–9000)"
                app:helperText="1380–1480 disarankan untuk game online (seperti Minecraft)"
                app:helperTextTextColor="@color/text_dim">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMtu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRuntimeProfile"
                style="@style/Widget.RustRay.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Profil Runtime TUN">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddRuntimeProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swIpv6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Rute IPv6 (::/0)"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matikan bila server hanya IPv4 untuk mencegah delay fallback IPv6."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swRebind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Auto Network Rebind"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minta rebind otomatis saat jaringan berpindah antara Wi-Fi dan seluler."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SNIFFING &amp; DNS"
                android:textAppearance="@style/TextAppearance.RustRay.Label" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSniffing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sniffing Paket (HTTP / TLS / QUIC)"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matikan untuk mengurangi latensi inspeksi awal pada paket game."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSniffingMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sniffing Metadata Only"
                android:textColor="@color/text" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFakeIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FakeIP DNS (198.19.0.0/16)"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matikan jika game/VoIP/anti-cheat bermasalah dengan IP palsu; DNS akan memakai server di bawah."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDnsServers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="DNS Servers (pisahkan koma)"
                app:helperText="Contoh: 1.1.1.1, 8.8.8.8 (dipakai saat FakeIP mati)"
                app:helperTextTextColor="@color/text_dim">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDnsServers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQueryStrategy"
                style="@style/Widget.RustRay.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="DNS Query Strategy">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddQueryStrategy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SPLIT TUNNELING (PER-APP VPN)"
                android:textAppearance="@style/TextAppearance.RustRay.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSplitMode"
                style="@style/Widget.RustRay.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Mode Split Tunneling">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/ddSplitMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickApps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pilih Aplikasi (0 terpilih)"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gunakan 'Hanya aplikasi terpilih' untuk mengisolasi trafik game agar tidak terganggu download/update aplikasi lain."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
